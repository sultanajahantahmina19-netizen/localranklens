# LocalRankLens environment variables
# Copy to .env for local development. Never commit real values.

# --- Database & auth (public values: safe in the browser) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server-only (never prefix with VITE_) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Billing ---
# "sandbox" (default): users can switch plans themselves for testing.
# "live": self-serve plan switching is disabled; a payment provider webhook sets plans.
BILLING_MODE=sandbox

# --- SEO ---
# Optional canonical origin for sitemap.xml, e.g. https://localranklens.com
PUBLIC_SITE_URL=
